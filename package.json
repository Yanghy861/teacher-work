{
  "name": "teacher-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "教师工作台 V1 的 Windows 优先 Electron 桌面应用",
  "type": "commonjs",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.teacherworkbench.desktop",
    "productName": "教师工作台",
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "chokidar": "4.0.3",
    "electron": "^43.4.1",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "officeparser": "7.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
